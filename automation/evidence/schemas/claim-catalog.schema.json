{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seamscope.local/schemas/claim-catalog.schema.json",
  "title": "SeamScope draft claim and property catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "propertyScope", "properties", "claims"],
  "properties": {
    "schemaVersion": {"const": "0.1-draft"},
    "catalogId": {"type": "string", "minLength": 1},
    "propertyScope": {"const": "identified-open-world"},
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "definition"],
        "properties": {
          "id": {"type": "string", "pattern": "^property\\.[a-z0-9.-]+$"},
          "label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "proposition", "assuranceTarget", "materialPropertyIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^claim\\.[a-z0-9.-]+$"},
          "proposition": {"type": "string", "minLength": 1},
          "assuranceTarget": {"type": "string", "minLength": 1},
          "materialPropertyIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^property\\.[a-z0-9.-]+$"}
          }
        }
      }
    }
  }
}
