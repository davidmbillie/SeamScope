{
  "name": "@seamscope/automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:evidence": "node ./scripts/audit-evidence.mjs",
    "audit:evidence:strict": "node ./scripts/audit-evidence.mjs --strict",
    "plan:generate": "node ./scripts/generate-run-plan.mjs",
    "representatives:check": "node ./scripts/generate-representative-timelines.mjs --check",
    "representatives:generate": "node ./scripts/generate-representative-timelines.mjs",
    "results:summarize": "node ./scripts/summarize-evidence.mjs",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:e2e:managed": "node ./scripts/run-e2e-managed.mjs",
    "test:evidence": "node --test \"./test/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "typescript": "^5.9.3",
    "webdriverio": "^9.31.9"
  }
}
